# Copia este archivo como .env y completa tus claves. NUNCA subas .env a git.

# --- Motor ---
PORT=8080
# Token para entrar al panel (invéntalo largo). Obligatorio si expones el Motor a internet.
ADMIN_TOKEN=
# URL pública (Cloudflare Tunnel o tu servidor), para mostrar la URL del webhook.
PUBLIC_URL=

# --- Inteligencia artificial (DeepSeek por defecto; sirve cualquier API compatible con OpenAI) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Palabra secreta que inventas y pegas también en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
# App Secret de tu app de Meta (verifica que los webhooks vienen de Meta).
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# --- Wompi (opcional, links de pago Bancolombia/Nequi/PSE) ---
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
