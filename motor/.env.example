# Este archivo es OPCIONAL. Todo se configura desde el panel (Conexiones y Ajustes) o con la
# terminal (motor estado, motor ia, motor whatsapp, motor wompi, motor token ...).
#
# Los valores de aqui solo se usan como semilla en el PRIMER arranque, cuando la base de datos
# aun esta vacia. Despues, la base de datos manda y cambiar este archivo no tiene efecto.
# Sirve para despliegues automaticos (Docker, servidores) donde no hay nadie que abra el panel.
# NUNCA subas tu .env a git.

# --- Motor (estos si se leen siempre) ---
PORT=8080
# Carpeta de la base de datos y los archivos recibidos. Por defecto: ./data
# DATA_DIR=

# --- Semilla inicial (opcional) ---
# Token para entrar al panel desde otros equipos (minimo 8 caracteres).
ADMIN_TOKEN=
# Direccion publica (Cloudflare Tunnel o tu servidor), para armar las URL de los webhooks.
PUBLIC_URL=

# Inteligencia artificial: sirve cualquier API compatible con OpenAI (DeepSeek, OpenAI, Arxi, ...)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7

# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# Wompi (opcional)
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
